<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PropertyPulse.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PropertyPulse.App.Views"
    xmlns:vm="clr-namespace:PropertyPulse.App.ViewModels"
    x:DataType="vm:ShellViewModel"
    FlyoutBehavior="Disabled"
    Title="PropertyPulse">

    <ShellContent
        ContentTemplate="{DataTemplate views:StartupPage}"
        Route="startup" />
    <ShellContent
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="login" />

    <TabBar>
        <ShellContent
            Title="Properties"
            ContentTemplate="{DataTemplate views:PropertiesPage}"
            Route="properties" />
        <ShellContent
            Title="Leads"
            ContentTemplate="{DataTemplate views:LeadsPage}"
            Route="leads" />
        <ShellContent
            Title="Visits"
            ContentTemplate="{DataTemplate views:VisitsPage}"
            Route="visits" />
        <ShellContent
            Title="Dashboard"
            ContentTemplate="{DataTemplate views:DashboardPage}"
            IsVisible="{Binding IsManager}"
            Route="dashboard" />
        <ShellContent
            Title="Settings"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="settings" />
    </TabBar>

</Shell>
