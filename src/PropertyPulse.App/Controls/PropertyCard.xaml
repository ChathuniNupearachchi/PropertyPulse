<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="PropertyPulse.App.Controls.PropertyCard"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:PropertyPulse.App.Converters"
    xmlns:local="clr-namespace:PropertyPulse.App.Controls"
    x:Name="Card"
    x:DataType="local:PropertyCard">

    <ContentView.Resources>
        <converters:PropertyImagesToCoverUrlConverter x:Key="CoverUrl" />
    </ContentView.Resources>

    <Border BindingContext="{x:Reference Card}">
        <VerticalStackLayout Spacing="0">
            <Image
                Aspect="AspectFill"
                HeightRequest="160"
                Source="{Binding Property.Images, Converter={StaticResource CoverUrl}}" />

            <VerticalStackLayout Style="{StaticResource CardContentLayout}">
                <Label Style="{StaticResource HeadingLabel}" Text="{Binding Property.Title}" />
                <Label Style="{StaticResource BodyLabel}" Text="{Binding Property.PriceLkr, StringFormat='LKR {0:N0}'}" />
                <Label Style="{StaticResource CaptionLabel}" Text="{Binding Property.City}" />
                <Label Style="{StaticResource CaptionLabel}" Text="{Binding Property.Status}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>

</ContentView>
