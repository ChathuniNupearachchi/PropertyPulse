<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PropertyPulse.App.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:PropertyPulse.App.ViewModels"
    x:Name="Page"
    x:DataType="vm:LoginViewModel"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsNotEmpty" />
    </ContentPage.Resources>

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType={x:Null}}"
            Command="{Binding AppearingCommand}"
            EventName="Appearing" />
    </ContentPage.Behaviors>

    <ScrollView>
        <VerticalStackLayout Style="{StaticResource FormLayout}">
            <Label Style="{StaticResource TitleLabel}" Text="PropertyPulse" />
            <Label Style="{StaticResource BodyLabel}" Text="Sign in to continue" />

            <Entry
                Keyboard="Email"
                Placeholder="Email"
                Text="{Binding Email}" />
            <Label
                IsVisible="{Binding EmailError, Converter={StaticResource IsNotEmpty}}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding EmailError}" />

            <Entry
                IsPassword="True"
                Placeholder="Password"
                ReturnCommand="{Binding SignInCommand}"
                Text="{Binding Password}" />
            <Label
                IsVisible="{Binding PasswordError, Converter={StaticResource IsNotEmpty}}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding PasswordError}" />

            <Label
                IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotEmpty}}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ErrorMessage}" />

            <Button Command="{Binding SignInCommand}" Text="Sign in" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Style="{StaticResource CaptionLabel}" Text="Server address" />
            <Entry
                Keyboard="Url"
                Placeholder="http://192.168.1.20:5000"
                Text="{Binding ServerUrl}" />
            <Label
                IsVisible="{Binding ServerUrlError, Converter={StaticResource IsNotEmpty}}"
                Style="{StaticResource ErrorLabel}"
                Text="{Binding ServerUrlError}" />
            <Label
                Style="{StaticResource CaptionLabel}"
                Text="On a physical phone, enter the address of the computer running the API on the same Wi-Fi network." />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
