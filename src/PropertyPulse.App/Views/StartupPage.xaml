<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="PropertyPulse.App.Views.StartupPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:PropertyPulse.App.ViewModels"
    x:Name="Page"
    x:DataType="vm:StartupViewModel"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="False">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding BindingContext, Source={x:Reference Page}, x:DataType={x:Null}}"
            Command="{Binding AppearingCommand}"
            EventName="Appearing" />
    </ContentPage.Behaviors>

    <VerticalStackLayout Style="{StaticResource SplashLayout}">
        <Label Style="{StaticResource TitleLabel}" Text="{Binding Title}" />
        <ActivityIndicator IsRunning="True" />
    </VerticalStackLayout>

</ContentPage>
